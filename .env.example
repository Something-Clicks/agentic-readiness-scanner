# Copy this to .env and fill in real values. Never commit .env.

# Server
PORT=3000

# Scan behavior
# Honest, disclosed user agent used for all fetches — never spoof another crawler's identity.
# The service refuses to start if this string impersonates a known crawler.
SCAN_USER_AGENT="SomethingClicksBot/1.0 (+https://somethingclicks.com/bot)"

# How long to wait on a single page before giving up, in milliseconds.
SCAN_FETCH_TIMEOUT_MS=15000

# Ceiling on a whole scan, in milliseconds. Scans run synchronously, so this bounds
# the HTTP response too.
SCAN_TIMEOUT_MS=60000

# Largest response body to read, in bytes. Anything past this is read in part and flagged.
SCAN_MAX_BODY_BYTES=3000000

# Key pages to fetch beyond the homepage (services / contact / booking).
SCAN_MAX_KEY_PAGES=3

# Response times past these thresholds are flagged as likely to exhaust a bot's
# fetch budget, in milliseconds.
SCAN_SLOW_RESPONSE_MS=2500
SCAN_VERY_SLOW_RESPONSE_MS=5000

# Add API keys, database URLs, etc. here as the stack is chosen.
