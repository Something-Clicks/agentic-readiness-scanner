# Copy this to .env and fill in real values. Never commit .env.

# Server
PORT=3000

# Scan behavior
# Honest, disclosed user agent used for all fetches — never spoof another crawler's identity.
# Optional: if unset, the value below is used as a built-in default. What the service
# refuses is a value that impersonates a known crawler (Googlebot, ClaudeBot,
# PerplexityBot, and so on) — that throws at startup.
#
# NOTE: the URL in this string must resolve to a page explaining the bot before the
# scanner is run against anyone else's site. See "Prerequisite" in the README.
SCAN_USER_AGENT="SomethingClicksBot/1.0 (+https://somethingclicks.com/bot)"

# How long to wait on a single page before giving up, in milliseconds. Each fetch is
# also capped by whatever is left of the scan budget below, so this is an upper bound.
SCAN_FETCH_TIMEOUT_MS=5000

# Ceiling on a whole scan, in milliseconds, and therefore on the HTTP response —
# scans run synchronously. The default fits inside a 10-second serverless function
# limit with room for cold start. Raise both this and SCAN_FETCH_TIMEOUT_MS if the
# host allows longer requests. Work the budget cuts short is named in the report
# rather than dropped.
SCAN_TIMEOUT_MS=8000

# Largest response body to read, in bytes. Anything past this is read in part and flagged.
SCAN_MAX_BODY_BYTES=3000000

# Key pages to fetch beyond the homepage (services / contact / booking).
SCAN_MAX_KEY_PAGES=3

# How many sitemap locations to actually fetch. A site can declare any number of
# Sitemap: lines; probing all of them is how a scan turns into a thin, mostly
# timed-out report. The ones beyond this are listed as skipped.
SCAN_MAX_SITEMAP_CANDIDATES=5

# Response times past these thresholds are flagged as likely to exhaust a bot's
# fetch budget, in milliseconds.
SCAN_SLOW_RESPONSE_MS=2500
SCAN_VERY_SLOW_RESPONSE_MS=5000

# Add API keys, database URLs, etc. here as the stack is chosen.
